<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>PlsqlDoctor.Cli</RootNamespace>
    <AssemblyName>plsql-doctor</AssemblyName>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>plsql-doctor</ToolCommandName>
    <PackageId>PlsqlPerformanceDoctor</PackageId>
    <Description>Finds performance anti-patterns in Oracle PL/SQL code and DBMS_XPLAN execution plans.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/hesnacaliskan/plsql-performance-doctor</PackageProjectUrl>
    <RepositoryUrl>https://github.com/hesnacaliskan/plsql-performance-doctor</RepositoryUrl>
    <PackageTags>oracle;plsql;sql;performance;linter;static-analysis;xplan;sarif</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PlsqlDoctor.Core\PlsqlDoctor.Core.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="PlsqlDoctor.Tests" />
  </ItemGroup>
</Project>
